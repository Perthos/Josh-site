---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, href, formatDate } from '../lib/site';

const pieces = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = pieces.slice(0, 5);
---

<Base title={SITE.title} description={SITE.description} ogSlug="home">
  <div class="page-head page-head--display">
    <h1>{SITE.name}</h1>
    <p class="lede">{SITE.description}</p>
    <hr class="page-head__rule" />
  </div>

  <div class="prose">
    <p>
      The work is a series on one question: when producing code gets cheaper
      but judgment, validation, and coordination don't, what happens to the
      engineering organization?
    </p>
    <p>
      Start with <a href={href('/writing')}>the writing</a>, or read{' '}
      <a href={href('/standards')}>the standards</a> it is held to. Every
      number and every attribution carries a named source and a live link, or
      it comes out of the piece.
    </p>
  </div>

  {
    latest.length > 0 && (
      <>
        <h2 class="section-head">Latest</h2>
        <ul class="entries">
          {latest.map((piece) => (
            <li class="entry">
              {piece.data.series && (
                <span class="eyebrow">{piece.data.series}</span>
              )}
              <h3 class="entry__title">
                <a href={href(`/writing/${piece.id}`)}>{piece.data.title}</a>
              </h3>
              <span class="meta entry__date">
                <time datetime={piece.data.date.toISOString()}>
                  {formatDate(piece.data.date)}
                </time>
              </span>
              <p class="entry__summary">{piece.data.description}</p>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <div class="tailpiece">
    <p>
      <a href={href('/rss.xml')}>Subscribe by feed</a>. No list, no sign-up.
    </p>
  </div>
</Base>
