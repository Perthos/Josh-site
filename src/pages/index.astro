---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, href, formatDate } from '../lib/site';

const pieces = (
  await getCollection('writing', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = pieces.slice(0, 5);
---

<Base title={SITE.title} description={SITE.description} ogSlug="home">
  <div class="page-head page-head--display">
    <h1>{SITE.name}</h1>
    <p class="lede">{SITE.focus}.</p>
    <p class="meta">
      Previously SVP Engineering at Comscore, with earlier roles at Tableau
      and Micron.
    </p>
    <hr class="page-head__rule" />
  </div>

  <div class="prose">
    <p>
      I've worked across engineering, product, program management, and
      architecture. I'm interested in how the parts of a system fit together,
      what we're trying to change, and which technical choices will actually
      help. <a href={href('/about')}>More about my work</a>.
    </p>
  </div>

  {
    latest.length > 0 && (
      <>
        <h2 class="section-head">Writing</h2>
        <ul class="entries">
          {latest.map((piece) => (
            <li class="entry">
              <h3 class="entry__title">
                <a href={href(`/writing/${piece.id}`)}>{piece.data.title}</a>
              </h3>
              <span class="meta entry__date">
                <time datetime={piece.data.date.toISOString()}>
                  {formatDate(piece.data.date)}
                </time>
              </span>
              <p class="entry__summary">{piece.data.description}</p>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2 class="section-head">Grow Youth Giving</h2>
  <div class="prose">
    <p>
      I built Grow Youth Giving to help families and communities introduce
      young people to giving. It shares a simple family grant-making program
      and materials you can adapt to your own budget and circumstances.
    </p>
    <p>
      I think learning about money should include understanding nonprofits,
      choosing what to support, and explaining why. This is one way to make
      that teaching part of family and community life.
      <a href={href('/giving')}> Explore Grow Youth Giving</a>.
    </p>
  </div>

  <h2 class="section-head">Field Guide</h2>
  <div class="prose">
    <p>
      Eighteen sayings I use as design principles, with the reasoning
      underneath each one. Written in July 2026 for the architects I led, and
      published unchanged. <a href={href('/field-guide')}>Read the Field
      Guide</a>.
    </p>
  </div>

  <div class="tailpiece">
    <p>
      <a href={href('/rss.xml')}>Writing feed</a>.
      <a href={href('/standards')}> How I use evidence</a>.
    </p>
  </div>
</Base>
