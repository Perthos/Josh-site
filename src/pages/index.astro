---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, href, formatDate } from '../lib/site';

const pieces = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = pieces.slice(0, 5);
---

<Base title={SITE.title} description={SITE.description} ogSlug="home">
  <h1>{SITE.name}</h1>
  <p class="lede">{SITE.description}</p>

  <p>
    Start with <a href={href('/writing')}>the writing</a>, or read{' '}
    <a href={href('/standards')}>the standards</a> the writing is held to.
  </p>

  {
    latest.length > 0 && (
      <>
        <h2>Latest</h2>
        <ul class="piece-list">
          {latest.map((piece) => (
            <li>
              {piece.data.series && (
                <p class="series-tag">{piece.data.series}</p>
              )}
              <h2>
                <a href={href(`/writing/${piece.id}`)}>{piece.data.title}</a>
              </h2>
              <p class="meta">
                <time datetime={piece.data.date.toISOString()}>
                  {formatDate(piece.data.date)}
                </time>
              </p>
              <p>{piece.data.description}</p>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <p><a href={href('/rss.xml')}>Subscribe by feed</a> — no list, no sign-up.</p>
</Base>
