---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
---

<Base
  title="Page not found"
  description="That page does not exist."
  ogSlug="home"
>
  <div class="page-head">
    <h1>Page not found</h1>
    <hr class="page-head__rule" />
  </div>

  <div class="prose">
    <p>
      Nothing lives at that address. Try{' '}
      <a href={href('/writing')}>the writing index</a> or the{' '}
      <a href={href('/')}>front page</a>.
    </p>
  </div>
</Base>
