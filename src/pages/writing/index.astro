---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { href, formatDate } from '../../lib/site';

const pieces = (
  await getCollection('writing', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Writing"
  description="Writing about architecture, systems, and engineering judgment."
  ogSlug="writing"
>
  <div class="page-head">
    <h1>Writing</h1>
    <p class="lede">
      Architecture, systems, and engineering judgment.
    </p>
    <hr class="page-head__rule" />
  </div>

  {
    pieces.length === 0 ? (
      <p>Nothing published yet.</p>
    ) : (
      <ul class="entries">
        {pieces.map((piece) => (
          <li class="entry">
            <h2 class="entry__title">
              <a href={href(`/writing/${piece.id}`)}>{piece.data.title}</a>
            </h2>
            <span class="meta entry__date">
              <time datetime={piece.data.date.toISOString()}>
                {formatDate(piece.data.date)}
              </time>
            </span>
            <p class="entry__summary">{piece.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }

  <div class="tailpiece">
    <p><a href={href('/rss.xml')}>Feed</a></p>
  </div>
</Base>
