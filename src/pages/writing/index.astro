---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { href, formatDate } from '../../lib/site';

const pieces = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Writing"
  description="Every piece published here, newest first."
  ogSlug="writing"
>
  <div class="page-head">
    <h1>Writing</h1>
    <p class="lede">Every piece published here, newest first.</p>
    <hr class="page-head__rule" />
  </div>

  {
    pieces.length === 0 ? (
      <p>Nothing published yet.</p>
    ) : (
      <ul class="entries">
        {pieces.map((piece) => (
          <li class="entry">
            {piece.data.series && (
              <span class="eyebrow">{piece.data.series}</span>
            )}
            <h2 class="entry__title">
              <a href={href(`/writing/${piece.id}`)}>{piece.data.title}</a>
            </h2>
            <span class="meta entry__date">
              <time datetime={piece.data.date.toISOString()}>
                {formatDate(piece.data.date)}
              </time>
            </span>
            <p class="entry__summary">{piece.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }

  <div class="tailpiece">
    <p><a href={href('/rss.xml')}>Feed</a></p>
  </div>
</Base>
