---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { href, formatDate } from '../../lib/site';

/*
 * SOURCE TRACE (Site build 2, Perthos/Research#138)
 *
 * The question: `notes/piece-sequencing.md`, "The series question", in the form
 * ruled on 2026-08-22 (the "dramatically" cut). A later amendment proposing to
 * open the question further is on the record and unsigned, so this form stands.
 *
 * The roadmap (three committed pieces, one sentence each) and the
 * "labelled as a call" paragraph were cut 2026-09-02 on operator ruling: the
 * page carries the question and the published pieces, and nothing about what
 * is coming.
 *
 * Voice: zero em-dashes.
 */

const pieces = (
  await getCollection(
    'writing',
    ({ data }) => !data.draft && data.series !== 'Notes',
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Writing"
  description="A series on one question: when producing code gets cheaper but judgment, validation, and coordination don't, what happens to the engineering organization?"
  ogSlug="writing"
>
  <div class="page-head">
    <h1>Writing</h1>
    <p class="lede">
      A series on one question: when producing code gets cheaper but judgment,
      validation, and coordination don't, what happens to the engineering
      organization?
    </p>
    <hr class="page-head__rule" />
  </div>

  {
    pieces.length === 0 ? (
      <p>Nothing published yet.</p>
    ) : (
      <>
        <h2 class="section-head">Published</h2>
        <ul class="entries">
          {pieces.map((piece) => (
            <li class="entry">
              {piece.data.series && (
                <span class="eyebrow">{piece.data.series}</span>
              )}
              <h3 class="entry__title">
                <a href={href(`/writing/${piece.id}`)}>{piece.data.title}</a>
              </h3>
              <span class="meta entry__date">
                <time datetime={piece.data.date.toISOString()}>
                  {formatDate(piece.data.date)}
                </time>
              </span>
              <p class="entry__summary">{piece.data.description}</p>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <div class="tailpiece">
    <p><a href={href('/rss.xml')}>Feed</a></p>
  </div>
</Base>
