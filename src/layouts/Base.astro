---
import '../styles/global.css';
import { SITE, NAV, FOOTER_LINKS, FOOTER_NOTE, href } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Slug of the generated social card at /og/<ogSlug>.png */
  ogSlug: string;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
}

const { title, description, ogSlug, ogType = 'website', publishedAt } =
  Astro.props;

const canonical = new URL(
  Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`,
  Astro.site,
);
const ogImage = new URL(href(`/og/${ogSlug}.png`), Astro.site);
// The home tab title carries the identity line's first clause so a cold
// arrival (search result, shared link) gets a descriptor, not a bare name.
const pageTitle =
  title === SITE.title
    ? `${SITE.name} — engineering executive and practicing architect`
    : `${title} — ${SITE.name}`;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Self-hosted, latin-subset, variable. Declared here rather than in the
// stylesheet so the URLs go through href() and survive a sub-path deploy.
// Built by tools/build-fonts.py; the whole served payload is about 102 KB.
const serif = href('/fonts/newsreader-latin.woff2');
const serifItalic = href('/fonts/newsreader-latin-italic.woff2');
const sans = href('/fonts/inter-latin.woff2');
const fontFaces = `
@font-face {
  font-family: 'Newsreader';
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url('${serif}') format('woff2');
}
@font-face {
  font-family: 'Newsreader';
  font-style: italic;
  font-weight: 400 500;
  font-display: swap;
  src: url('${serifItalic}') format('woff2');
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url('${sans}') format('woff2');
}`;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={serif}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={sans}
      crossorigin="anonymous"
    />
    <style is:inline set:html={fontFaces}></style>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — writing`}
      href={href('/rss.xml')}
    />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE.domain}`} />
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href={href('/')}>{SITE.name}</a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {
              NAV.map((item) => {
                const path = href(item.href).replace(/\/$/, '') || '/';
                const home = href('/').replace(/\/$/, '') || '/';
                const active =
                  path === currentPath ||
                  (path !== home && currentPath.startsWith(`${path}/`));
                return (
                  <li>
                    <a href={href(item.href)} aria-current={active ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="shell">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <ul>
          {
            FOOTER_LINKS.map((link) => (
              <li>
                <a
                  href={link.external ? link.href : href(link.href)}
                  rel={link.external ? 'me noopener' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="footer-note">{FOOTER_NOTE}</p>
        <p>© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
